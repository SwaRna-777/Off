PORT=8787
HOST=127.0.0.1
# Set this to your HTTPS tunnel or deployment origin before connecting ChatGPT.
# Public origins require OAuth or a strong token for compatible development clients.
PUBLIC_BASE_URL=
# Future ChatGPT connection: configure an external OAuth 2.1 provider.
# Leave these blank for local-only testing. No provider is configured by this file.
OAUTH_ISSUER=
OAUTH_JWKS_URL=
# Defaults to PUBLIC_BASE_URL followed by /mcp.
OAUTH_AUDIENCE=
OAUTH_SCOPES=resume:use
# Optional: restrict access to the subject identifier of your own IdP account.
OAUTH_ALLOWED_SUBJECT=
# Development clients only; ChatGPT does not support a custom static bearer token.
# Required for public URLs/non-loopback HOST when OAuth is not configured.
# Generate locally with: openssl rand -hex 32
# Use only a client that can send this token. Never commit a real token.
MCP_BEARER_TOKEN=
